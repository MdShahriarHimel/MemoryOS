# ---- MEMORY OS environment (copy to .env; never commit secrets) ----
# There are deliberately NO LLM / embedding provider keys. MEMORY OS is
# model-independent; clients supply their own embeddings.

DATABASE_URL=postgresql+asyncpg://memoryos:memoryos@localhost:5432/memoryos
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=memoryos-graph
OPENSEARCH_URL=http://localhost:9200

EMBEDDING_DIM=1536

JWT_SECRET=change-me-in-production
API_KEY_PEPPER=change-me-pepper

# Rate limiting (Redis-backed when REDIS_URL is set)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=memory-os-api

# Prometheus
PROMETHEUS_ENABLED=true
METRICS_TOKEN=

# Local dev: allow unauthenticated API access with X-Tenant-ID (never in production)
MEMORY_OS_ALLOW_ANON=true

# PostgreSQL RLS
POSTGRES_RLS_ENABLED=true

# Object storage (local | s3)
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=./storage
S3_BUCKET=memory-os
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=memoryos
AWS_SECRET_ACCESS_KEY=memoryos-secret

# Usage metering
USAGE_METERING_ENABLED=true

# Server-side only (never exposed to the browser)
MEMORY_OS_API_URL=http://api:8000

# Browser-safe
NEXT_PUBLIC_MEMORY_OS_API_URL=http://localhost:8000

# CLI
MEMORY_OS_TOKEN=
